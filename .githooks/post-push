#!/usr/bin/env bash
# After git push: ensure PR exists and run post-workflow automation.
# Install: bash scripts/install-git-hooks.sh

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
BRANCH="$(git branch --show-current)"

if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
  bash "$ROOT/scripts/post-workflow.sh" || true
  exit 0
fi

bash "$ROOT/scripts/ensure-pr.sh" main
bash "$ROOT/scripts/post-workflow.sh" || true
