#!/usr/bin/env bash
# Before commit: block secrets, sync WBS, validate staged public md and ADRs.
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)
bash $ROOT/scripts/pre-commit-secret-check.sh
bash $ROOT/scripts/sync-wbs-roadmap.sh --stage || true

mapfile -t STAGED_MD < <(
  git diff --cached --name-only --diff-filter=ACM -- README.md CONTEXT.md frontend/README.md docs/ 2>/dev/null \
    | grep -E '\.md$' || true
)

STAGED_ADR=()
STAGED_PUBLIC=()
for f in "${STAGED_MD[@]}"; do
  if [[ "$f" == docs/adr/* ]]; then
    STAGED_ADR+=("$f")
  elif [[ "$f" == docs/agents/* || "$f" == docs/local/* ]]; then
    continue
  else
    STAGED_PUBLIC+=("$f")
  fi
done

if [[ ${#STAGED_ADR[@]} -gt 0 ]]; then
  bash $ROOT/scripts/validate-adrs.sh
fi

if [[ ${#STAGED_PUBLIC[@]} -gt 0 ]]; then
  bash $ROOT/scripts/validate-public-docs.sh "${STAGED_PUBLIC[@]}"
fi
