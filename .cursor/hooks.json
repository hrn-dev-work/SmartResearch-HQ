{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/before-submit-prompt.sh",
        "matcher": "UserPromptSubmit"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/track-code-edit.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-retrospective.sh",
        "loop_limit": 2
      }
    ]
  }
}
