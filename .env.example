# ── Application mode ──────────────────────────────────────────
# portfolio = Mock API (public demo) | production = full backend
APP_MODE=portfolio

# ── Candidate matching (production only) ────────────────────
# amazon_search = title-based Amazon PA-API (default) | none = manual | gemini = optional multimodal
MATCHING_PROVIDER=amazon_search

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated CORS origins for deployed frontend (localhost always allowed)
ALLOWED_ORIGINS=
# Public API rate limit (per client IP; /api/v1/health exempt)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SEC=60
DATABASE_URL=postgresql+asyncpg://smartresearch:smartresearch@localhost:5432/smartresearch
REDIS_URL=redis://localhost:6379/0

# ── Amazon PA-API 5.0 (production / MATCHING_PROVIDER=amazon_search) ──
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_REGION=us-east-1

# ── Gemini (optional — MATCHING_PROVIDER=gemini only) ────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free tier RPM ~15 — keep interval >= 4s between requests
GEMINI_MIN_INTERVAL_SEC=4
GEMINI_MAX_RETRIES=3

# ── Google Sheets (production only) ─────────────────────────
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEET_ID=

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
